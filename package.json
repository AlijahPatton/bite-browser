{
  "name": "bite-browser",
  "version": "1.0.0",
  "description": "Bite Browser - A privacy-focused mobile browser",
  "main": "index.js",
  "scripts": {
    "build": "cp src/bite-browser-fixed.html dist/index.html",
    "cap:sync": "npx cap sync",
    "cap:build:android": "npx cap build android --prod",
    "android:assemble": "cd android && ./gradlew assembleRelease",
    "android:bundle": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
